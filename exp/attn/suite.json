    "samples_per_implementation": 15,
    "warmup_calls": 20,
    "target_ms": 10,
    "max_calls_per_graph": 1024,
    "modes": [
      "reuse",
      "rotating"
    ],
    "rotating_target_bytes": "max(64 MiB,2*device_L2)",
    "rotating_max_banks": 32,
    "bank_memory_limit": "25% of free VRAM after runtime initialization",
    "replay_lengths": "fixed; overwrite same new-token slots each replay",
    "comparison_statuses": [
      "ok",
      "not_installed",
      "unsupported",
      "memory_limit",
      "incorrect",
      "error"
    ],
    "flashinfer_workspace_mib": 256,
    "note": "128 MiB is insufficient for the largest FA2 prefill; all cases use the same 256 MiB limit"
