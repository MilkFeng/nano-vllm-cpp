{
  "schema_version": 1,
  "status": "implemented",
  "operation": "paged GQA attention with optional KV append",
  "profiles": {
    "qwen3_0p6b": {
      "query_heads": 16,
      "kv_heads": 8,
      "head_dim": 128
    },
    "qwen35_full_attention": {
      "query_heads": 16,
      "kv_heads": 2,
      "head_dim": 256
    }
  },
  "dtypes": [
    "float32",
    "float16",
    "bfloat16"
  ],
  "contract": {
    "query_output_layout": "packed_tokens,Hq,D",
    "kv_cache_layout": "separate K/V; pages,page_size,Hkv,D; NHD",
    "new_kv_layout": "packed_tokens,Hkv,D",
    "lengths": "kv_length includes new tokens; prefix_length=kv_length-query_length",
    "causal_rule": "key_index <= prefix_length + local_query_index",
    "gqa_rule": "kv_head = query_head // (Hq // Hkv)",
    "softmax_scale": "1/sqrt(head_dim)",
    "dropout": 0,
    "rope_in_operator": false,
    "alibi": false,
    "soft_cap": false,
    "window": "full",
    "default_page_size": 16
  },
  "primary_task": {
    "name": "paged_append_attention",
    "custom": "production fused append + attention",
    "baseline": "FlashInfer append_paged_kv_cache + paged attention run",
    "counts_append": true,
    "counts_layout_conversion": true,
    "counts_plan": false,
    "page_assignment": "seeded random permutation; no shared writable pages"
  },
  "full": {
    "logical_shapes_per_profile": 28,
    "logical_shapes_total": 56,
    "primary_cases_per_cache_mode": 168,
    "grids": [
      {
        "name": "prefill",
        "batch_sizes": [
          1,
          4
        ],
        "query_lengths": [
          128,
          512,
          2048
        ],
        "prefix_lengths": [
          0
        ],
        "kv_length": "prefix_length+query_length",
        "cases_per_profile": 6
      },
      {
        "name": "decode",
        "batch_sizes": [
          1,
          4,
          16
        ],
        "query_lengths": [
          1
        ],
        "kv_lengths": [
          128,
          512,
          2048,
          8192
        ],
        "prefix_length": "kv_length-1",
        "cases_per_profile": 12
      },
      {
        "name": "chunked_prefill",
        "batch_sizes": [
          1,
          4
        ],
        "query_lengths": [
          16,
          128
        ],
        "prefix_lengths": [
          512,
          2048
        ],
        "kv_length": "prefix_length+query_length",
        "cases_per_profile": 8
      }
    ],
    "ragged": [
      {
        "name": "ragged_decode",
        "query_lengths": [
          1,
