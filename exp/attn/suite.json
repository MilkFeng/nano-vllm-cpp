          17,
          65
        ],
        "prefix_lengths": [
          0,
          15,
          511,
          2047
        ]
      }
    ]
  },
  "secondary_tasks": [
    {
      "name": "dense_prefill_append_attention",
      "runner_task": "prefill",
      "custom": "same production API in src/kernels/cuda/attention.cu",
      "shapes": "full.prefill",
      "page_assignment": "identity; dense K/V are zero-copy views of the same cache",
      "baselines": [
        "torch_index_copy_append+sdpa_math+NHD_output",
        "torch_index_copy_append+sdpa_flash+NHD_output",
        "torch_index_copy_append+sdpa_cudnn+NHD_output",
        "flash_attention_optional"
      ],
      "counts_append": true,
      "counts_output_packing": true
    }
  ],
  "correctness": {
    "input_distribution": "normal(0,0.5), cast to target dtype before FP64 reference",
    "tolerances": {
      "float32": {
        "atol": 2e-05,
        "rtol": 0.0002
      },
      "float16": {
        "atol": 0.002,
        "rtol": 0.01
      },
      "bfloat16": {
        "atol": 0.01,
        "rtol": 0.03
      }
    },
    "query_length_edges": [
      0,
