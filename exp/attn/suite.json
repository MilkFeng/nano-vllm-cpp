    ],
    "causal_values": [
      true,
      false
    ],
    "check_output": true,
    "check_full_cache_mutation": true,
    "check_padding_and_unused_page_sentinels": true,
    "check_repeat_is_idempotent": true,
    "non_default_stream": true,
    "forbidden_inputs": [
      "kv_length<query_length",
      "shared writable pages",
      "invalid page ids"
