CompileFlags:
  CompilationDatabase: build
  # NVCC flags in CMake's compilation database are not Clang driver flags.
  Remove:
    - -forward-unknown-to-host-compiler
    - --generate-code=*
    - --display-error-number
    - --generate-line-info

---
If:
  PathMatch: .*\.(cu|cuh)
CompileFlags:
  Compiler: clang++
  Remove: [-x]
  Add: [-xcuda, --cuda-path=/usr/local/cuda, --cuda-gpu-arch=sm_120]
